# ==============================================================================
# KRAHASO WHATSAPP BOT - Environment Configuration
# ==============================================================================
# Copy this file to .env in the project root and fill in your values
#
# Variables marked with [REQUIRED] must be set
# Variables marked with [OPTIONAL] have sensible defaults
# ==============================================================================


# ==============================================================================
# Database (Turso) - REQUIRED
# Shared with the Nuxt app
# ==============================================================================

# [REQUIRED] Turso database connection URL
TURSO_DATABASE_URL=libsql://your-database.turso.io

# [REQUIRED] Turso authentication token
TURSO_AUTH_TOKEN=your-turso-auth-token


# ==============================================================================
# OpenAI Configuration - REQUIRED
# ==============================================================================

# [REQUIRED] OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key

# [OPTIONAL] OpenAI model to use
# Options: gpt-4o-mini, gpt-4o, gpt-5-nano, gpt-5-mini, gpt-5
# Default: gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# [OPTIONAL] OpenAI request timeout in milliseconds
# Default: 20000
OPENAI_TIMEOUT_MS=20000

# [OPTIONAL] Maximum retry attempts for OpenAI requests
# Default: 3
OPENAI_MAX_RETRIES=3

# [OPTIONAL] Base delay between OpenAI retries in milliseconds
# Default: 2000
OPENAI_RETRY_BASE_DELAY_MS=2000


# ==============================================================================
# API Connection - OPTIONAL
# ==============================================================================

# [OPTIONAL] Krahaso API URL for flight searches
# Default: http://localhost:3000
KRAHASO_API_URL=http://localhost:3000

# [OPTIONAL] Legacy alias (still supported)
AVIOPIKA_API_URL=http://localhost:3000

# [OPTIONAL] Krahaso website URL for booking links
# Auto-detected from KRAHASO_API_URL if not set
KRAHASO_URL=https://krahaso.co

# [OPTIONAL] Legacy alias (still supported)
AVIOPIKA_URL=https://krahaso.co


# ==============================================================================
# Rate Limiting - OPTIONAL
# ==============================================================================

# [OPTIONAL] Maximum messages per user per minute
# Default: 10
RATE_LIMIT_PER_MINUTE=10

# [OPTIONAL] Maximum messages per user per day
# Default: 100
RATE_LIMIT_PER_DAY=100


# ==============================================================================
# Conversation Settings - OPTIONAL
# ==============================================================================

# [OPTIONAL] Conversation timeout in milliseconds
# Default: 900000 (15 minutes)
CONVERSATION_TTL_MS=900000

# [OPTIONAL] Maximum messages to keep in conversation history
# Default: 10
CONVERSATION_MAX_HISTORY=10

# [OPTIONAL] Delay before sending "still processing" notice in milliseconds
# Default: 10000 (10 seconds)
PROCESSING_NOTICE_DELAY_MS=10000


# ==============================================================================
# WhatsApp Configuration - OPTIONAL
# ==============================================================================

# [OPTIONAL] Path to store WhatsApp authentication data
# Default: .wwebjs_auth
WHATSAPP_AUTH_PATH=.wwebjs_auth

# [OPTIONAL] Run WhatsApp in headless mode (no browser window)
# Default: true
WHATSAPP_HEADLESS=true


# ==============================================================================
# Debug Settings - OPTIONAL
# ==============================================================================

# [OPTIONAL] Enable debug mode
# Default: false
DEBUG=false

# [OPTIONAL] Log parsed queries to console
# Default: true
DEBUG_LOG_PARSED=true

# [OPTIONAL] Debug intent parsing
# Values: false, true (basic), full (detailed)
# Default: false
DEBUG_INTENT=false


# ==============================================================================
# QUICK START - Minimal Configuration
# ==============================================================================
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
# OPENAI_API_KEY=sk-your-key
# ==============================================================================
