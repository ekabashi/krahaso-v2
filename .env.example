# ==============================================================================
# APP - Google Tag Manager
# ==============================================================================

NUXT_PUBLIC_GTM_ID=

# ==============================================================================
# Autopika- Environment Configuration
# ==============================================================================
NUXT_PUBLIC_SITE_URL="http://localhost:3000" 
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

BREVO_API_KEY=



# ==============================================================================
# AVIOPIKA - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
#
# Variables marked with [REQUIRED] must be set
# Variables marked with [OPTIONAL] have sensible defaults
#
# For Bot-specific variables, see also: bot/.env.example
# ==============================================================================


# ==============================================================================
# DATABASE (Turso) - REQUIRED
# Shared by: App, Bot, Drizzle CLI
# ==============================================================================

# [REQUIRED] Turso database connection URL
TURSO_DATABASE_URL=libsql://your-database.turso.io

# [REQUIRED] Turso authentication token
TURSO_AUTH_TOKEN=your-turso-auth-token


# ==============================================================================
# APP - Authentication (Better Auth)
# ==============================================================================

# [REQUIRED in production] Secret key for signing sessions (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-chars

# [OPTIONAL] Base URL for auth endpoints
# Default: http://localhost:3000
BETTER_AUTH_URL=https://aviopika.al

# [OPTIONAL] Additional trusted origins for CSRF protection (comma-separated)
# Useful for preview deployments, staging environments
BETTER_AUTH_TRUSTED_ORIGINS=https://preview.aviopika.al,https://staging.aviopika.al


# ==============================================================================
# APP - Public Configuration
# Available on client and server
# ==============================================================================

# [OPTIONAL] WhatsApp number displayed on the website
# Default: +38349999408
NUXT_PUBLIC_WHATSAPP_NUMBER=+38349999408


# ==============================================================================
# APP - Provider HTTP Client
# ==============================================================================

# [OPTIONAL] Request timeout for provider APIs in milliseconds
# Default: 15000
PROVIDER_HTTP_TIMEOUT_MS=15000

# [OPTIONAL] Maximum retry attempts for failed requests
# Default: 2
PROVIDER_HTTP_MAX_RETRIES=2

# [OPTIONAL] Base delay between retries in milliseconds
# Default: 750
PROVIDER_HTTP_RETRY_DELAY_MS=750


# ==============================================================================
# APP - Background Sync
# ==============================================================================

# [OPTIONAL] Enable background sync scheduler
# Default: true in production, false otherwise
ENABLE_SYNC=true


# ==============================================================================
# BOT - Configuration (see bot/.env.example for full list)
# ==============================================================================

# [REQUIRED for bot] OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key

# [OPTIONAL] OpenAI model to use
# Options: gpt-4o-mini, gpt-4o, gpt-5-nano, gpt-5-mini, gpt-5
# Default: gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# [OPTIONAL] Aviopika API URL for flight searches
# Default: http://localhost:3000
AVIOPIKA_API_URL=http://localhost:3000

# [OPTIONAL] Aviopika website URL for booking links
AVIOPIKA_URL=https://aviopika.al


# ==============================================================================
# QUICK START
# ==============================================================================
# Minimal for App development:
#   TURSO_DATABASE_URL=libsql://your-db.turso.io
#   TURSO_AUTH_TOKEN=your-token
#   BETTER_AUTH_SECRET=dev-secret-minimum-32-characters-long
#
# Additional for Bot development:
#   OPENAI_API_KEY=sk-your-key
# ==============================================================================
